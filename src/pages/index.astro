---
import '../styles/global.css';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/chrislynde/' },
  { label: 'GitHub', href: 'https://github.com/LyndeCS' },
  { label: 'Email', href: 'mailto:lyndechris@gmail.com' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Chris Lynde — software solutions, automation, and process improvement." />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://chrislynde.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Chris Lynde — Software Solutions" />
    <meta property="og:description" content="Software solutions, automation, and process improvement." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chrislynde.com/" />
    <meta property="og:site_name" content="Chris Lynde" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Chris Lynde — Software Solutions" />
    <meta name="twitter:description" content="Software solutions, automation, and process improvement." />
    <title>Chris Lynde — Software Solutions</title>
  </head>
  <body>
    <main class="min-h-dvh px-6 py-8 sm:px-10 sm:py-10 lg:px-16 lg:py-8">
      <div class="mx-auto flex min-h-[calc(100dvh-4rem)] max-w-[1480px] flex-col sm:min-h-[calc(100dvh-5rem)] lg:min-h-[calc(100dvh-4rem)]">
        <header class="flex items-center justify-between gap-6 text-[0.72rem] font-medium uppercase tracking-[0.28em] text-zinc-500">
          <a href="/" aria-label="Chris Lynde home" class="text-zinc-900 transition-opacity hover:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6d5efc]">Chris Lynde</a>
          <span class="hidden normal-case tracking-normal text-zinc-500 sm:block">London, Ontario</span>
        </header>

        <section class="flex flex-1 items-center py-16 sm:py-20 lg:py-10 xl:py-12">
          <div class="w-full max-w-5xl">
            <div aria-hidden="true" class="mb-8 h-[3px] w-12 rounded-full bg-[#6d5efc] sm:mb-10 lg:mb-7"></div>

            <p class="mb-5 text-sm font-medium tracking-[0.08em] text-zinc-500 sm:text-base lg:mb-4">
              Software Solutions <span class="mx-2 text-zinc-300">·</span> Automation <span class="mx-2 text-zinc-300">·</span> Process Improvement
            </p>

            <h1 class="hero-title max-w-5xl font-semibold leading-[0.94] tracking-[-0.06em] text-zinc-950">
              I turn inefficient workflows into practical software solutions.
            </h1>

            <p class="mt-7 max-w-3xl text-lg leading-relaxed text-zinc-600 sm:mt-8 sm:text-xl lg:mt-6 lg:text-[1.25rem] lg:leading-[1.55]">
              I use software, automation, and system design to make everyday work simpler, faster, and more effective.
            </p>

            <nav aria-label="Contact and profile links" class="mt-9 flex flex-wrap gap-3 sm:mt-10 lg:mt-7">
              {links.map((link) => (
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                  class="group inline-flex items-center gap-3 rounded-full border border-zinc-300/80 bg-white/55 px-5 py-3 text-sm font-medium text-zinc-800 backdrop-blur-sm transition hover:-translate-y-0.5 hover:border-[#6d5efc]/50 hover:bg-[#6d5efc]/[0.03] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6d5efc]"
                >
                  {link.label}
                  <span aria-hidden="true" class="text-zinc-400 transition-all group-hover:translate-x-0.5 group-hover:text-[#6d5efc]">↗</span>
                </a>
              ))}
            </nav>
          </div>
        </section>

        <footer class="border-t border-zinc-200/80 pt-5 text-sm text-zinc-500 lg:pb-1">
          <div>
            <p class="mb-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-[#6d5efc]">Currently</p>
            <p class="text-zinc-800">Sales Representative · Noble</p>
            <p>London, Ontario</p>
          </div>
        </footer>
      </div>
    </main>
  </body>
</html>
