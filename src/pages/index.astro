---
import '../styles/global.css';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'GitHub', href: 'https://github.com/LyndeCS' },
  { label: 'Email', href: 'mailto:hello@chrislynde.ca' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Chris Lynde — software solutions, automation, and process improvement." />
    <meta name="theme-color" content="#f7f7f5" />
    <title>Chris Lynde — Software Solutions</title>
  </head>
  <body>
    <main class="min-h-screen px-6 py-8 sm:px-10 sm:py-10 lg:px-16 lg:py-12">
      <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-[1480px] flex-col sm:min-h-[calc(100vh-5rem)] lg:min-h-[calc(100vh-6rem)]">
        <header class="flex items-center justify-between gap-6 text-[0.72rem] font-medium uppercase tracking-[0.28em] text-zinc-500">
          <a href="/" class="text-zinc-900 transition-opacity hover:opacity-60">Chris Lynde</a>
          <span class="hidden normal-case tracking-normal text-zinc-500 sm:block">London, Ontario</span>
        </header>

        <section class="flex flex-1 items-center py-20 sm:py-24 lg:py-28">
          <div class="w-full max-w-5xl">
            <div class="mb-10 h-[3px] w-12 rounded-full bg-[#6d5efc] sm:mb-12"></div>

            <p class="mb-6 text-sm font-medium tracking-[0.08em] text-zinc-500 sm:text-base">
              Software Solutions <span class="mx-2 text-zinc-300">·</span> Automation <span class="mx-2 text-zinc-300">·</span> Process Improvement
            </p>

            <h1 class="max-w-5xl text-[clamp(3.25rem,8vw,7.8rem)] font-semibold leading-[0.94] tracking-[-0.065em] text-zinc-950">
              I turn inefficient workflows into practical software solutions.
            </h1>

            <p class="mt-8 max-w-3xl text-lg leading-relaxed text-zinc-600 sm:mt-10 sm:text-xl lg:text-[1.4rem] lg:leading-[1.6]">
              I use software, automation, and system design to make everyday work simpler, faster, and more effective.
            </p>

            <nav aria-label="Social links" class="mt-10 flex flex-wrap gap-3 sm:mt-12">
              {links.map((link) => (
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                  class="group inline-flex items-center gap-3 rounded-full border border-zinc-300/80 bg-white/55 px-5 py-3 text-sm font-medium text-zinc-800 backdrop-blur-sm transition hover:-translate-y-0.5 hover:border-zinc-400 hover:bg-white"
                >
                  {link.label}
                  <span aria-hidden="true" class="text-zinc-400 transition-transform group-hover:translate-x-0.5">↗</span>
                </a>
              ))}
            </nav>
          </div>
        </section>

        <footer class="flex flex-col gap-6 border-t border-zinc-200/80 pt-6 text-sm text-zinc-500 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-[#6d5efc]">Currently</p>
            <p class="text-zinc-800">Sales Representative · Noble</p>
            <p>London, Ontario</p>
          </div>

          <p class="max-w-xs text-left leading-relaxed sm:text-right">
            Software should reduce friction, not add to it.
          </p>
        </footer>
      </div>
    </main>
  </body>
</html>
